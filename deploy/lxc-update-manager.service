[Unit]
Description=LXC Update Manager
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/lxc-update-manager
ExecStart=/opt/lxc-update-manager/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
