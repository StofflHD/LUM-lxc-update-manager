# Proxmox host the wrapper is installed on
LUM_PVE_HOST=192.168.1.10
LUM_PVE_PORT=22
LUM_PVE_USER=root

# SSH key + known_hosts (create with: ssh-keyscan <host> > data/known_hosts)
LUM_SSH_KEY_PATH=data/id_ed25519
LUM_KNOWN_HOSTS_PATH=data/known_hosts

LUM_DB_PATH=data/lum.db
LUM_CHECK_INTERVAL_MINUTES=360

# Safety copy before every update: snapshot | vzdump | none
#   snapshot: fast, but lives on the same storage (needs LVM-thin, ZFS or Ceph)
#   vzdump:   real backup to LUM_BACKUP_STORAGE (dir, NFS, CIFS or PBS)
LUM_BACKUP_MODE=snapshot
# after a successful update keep only the newest N lum_* snapshots per container
LUM_SNAPSHOT_KEEP=2
LUM_BACKUP_STORAGE=
# vzdump mode: snapshot | suspend | stop
LUM_BACKUP_VZDUMP_MODE=snapshot
# after a successful update keep only the newest N backups made by the manager
LUM_BACKUP_KEEP=2
LUM_MAX_PARALLEL_CHECKS=4

# free space (MB) needed in the guest's / before an update, 0 = no check
LUM_MIN_FREE_MB=500
# default of "Clean up afterwards": apt autoremove + apt clean after an OS update
LUM_CLEANUP=true

# Automatic updates in a maintenance window (guests: "Auto-update ..." in the web UI)
#   days: sun | sat,sun | mon-fri | daily (empty = off); times HH:MM, local time
LUM_AUTO_DAYS=
LUM_AUTO_TIME=03:00
# optional end: guests not started by then are cancelled
LUM_AUTO_UNTIL=
# afterwards restart guests that need it (never LUM's own container)
LUM_AUTO_RESTART=false

# Notifications through a Telegram bot: token from @BotFather, chat id of you or a group
LUM_TELEGRAM_TOKEN=
LUM_TELEGRAM_CHAT_ID=
# per update / bulk update: failures | all | off
LUM_NOTIFY=failures
# after the scheduled check: which updates are available (only when it changed)
LUM_NOTIFY_UPDATES=true

# optional GitHub token (no scopes needed) for the release lookups, 60 -> 5000 req/h
LUM_GITHUB_TOKEN=

# Web UI login. Set the password with (in /opt/lxc-update-manager):
#   venv/bin/python -m app.passwd [username]
LUM_AUTH_FILE=data/auth.json
# signs the session cookies, created automatically
LUM_SECRET_FILE=data/secret.key
LUM_SESSION_HOURS=12
# true only if a reverse proxy already authenticates (Authelia, Authentik, ...)
LUM_AUTH_DISABLED=false
# Force the Secure flag on the session cookie. Not needed behind a trusted HTTPS
# reverse proxy (see FORWARDED_ALLOW_IPS), there it is set automatically.
LUM_COOKIE_SECURE=false

# Reverse proxy: IP(s) of the proxy whose X-Forwarded-For / X-Forwarded-Proto headers
# are trusted (comma separated, networks allowed). Needed so the login lockout counts
# per real client instead of per proxy. Read by uvicorn, not by LUM itself.
#FORWARDED_ALLOW_IPS=192.168.1.20

# true = fake containers, no SSH (for UI development)
LUM_DEMO=false
